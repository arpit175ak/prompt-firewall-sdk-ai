ACCUKNOX_PF_TOKEN=replace_with_prompt_firewall_token
PF_USER_INFO=your-name-or-email@example.com
FAIL_CLOSED=true
BLOCK_UNCHECKED=false
BLOCK_MONITOR=false
EXPOSE_RAW_PF_RESULT=false

# Live validation is disabled by default and must be deliberately enabled.
PF_LIVE_ENABLED=false
PF_MAX_LIVE_REQUESTS=20
PF_ALLOW_LIVE_SCAN=false
